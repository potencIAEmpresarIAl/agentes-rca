            },
            {
              "id": "r02",
              "name": "requiere_aviso",
              "type": "boolean",
              "value": "={{ $json.estado !== 'Entregado' && (!$json.fecha_valida || $json.dias_para_vencer <= 5) }}"
            }
          ]
        },
        "options": {}
